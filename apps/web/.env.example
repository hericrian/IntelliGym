# Endereço da API. O backend de dados é o Cloudflare Worker (perfil,
# equipamentos, planos e registros de dor no D1). Sem isto o app funciona
# só neste aparelho, guardando tudo em localStorage.
VITE_API_URL=https://intelligym-api.hericrianamf.workers.dev

# Firebase Authentication. Sem estas chaves o app entra em modo demonstração:
# dá para navegar, mas nada é sincronizado com o banco.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Links das lojas, quando o app nativo existir. Vazio = a landing mostra
# apenas a instalação como PWA.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_APP_DOWNLOAD_URL=
