/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# O service worker e o manifest precisam ser revalidados a cada visita, senão
# uma versão nova do app fica presa atrás do cache do navegador.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Assets com hash no nome nunca mudam de conteúdo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Modelo de visão computacional: grande e estável, vale cache longo.
/models/*
  Cache-Control: public, max-age=2592000, immutable
