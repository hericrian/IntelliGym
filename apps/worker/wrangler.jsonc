{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "intelligym-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Banco de dados dos usuários (perfil, equipamentos, planos, dor, sessões).
  // Crie uma vez com `npx wrangler d1 create intelligym` e cole aqui o
  // database_id devolvido pelo comando.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intelligym",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://intelligym.pages.dev,http://localhost:5173,http://localhost:4173",
    // Projeto do Firebase usado para validar a claim `aud` do ID token.
    // Não é segredo: também aparece no bundle do frontend.
    "FIREBASE_PROJECT_ID": "intelligym-46878"
  }
}
