{
  "name": "@intelligym/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify --keep-vars",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types",
    "lint": "eslint src --ext .ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"wrangler.jsonc\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250909.0",
    "wrangler": "^4.37.1"
  }
}
