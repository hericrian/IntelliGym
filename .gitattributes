# Normaliza finais de linha: LF no repositorio e na working tree.
# Evita que um clone no Windows (core.autocrlf=true) quebre o `npm run format:check`.
* text=auto eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
